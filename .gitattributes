* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Model manifests hash exact bytes. Do not normalize structured data files.
*.csv -text
*.json -text

# Binary formats must never receive line-ending conversion.
*.joblib binary
*.xlsx binary
*.zip binary
*.pdf binary
