# Naver Open API — 검색 API + 데이터랩(검색어 트렌드) API 공용 키
# developers.naver.com 에서 앱 등록 시 "검색" + "데이터랩" 둘 다 체크
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Naver 뉴스 검색 수집 옵션
NAVER_DISPLAY=100
NAVER_SORT=date
NAVER_MAX_PAGES=10
NAVER_RATE_LIMIT_SECONDS=0.25

# 수집기 옵션
NEWS_COLLECTOR_KEEP_RAW_PAYLOAD=true

# data.go.kr service key. Keep the real key in .env or the process environment.
DATA_GO_KR_SERVICE_KEY=

# 주의: OpenAI/Claude 등 closed API 모델은 오픈소스대회 규정(제9조)상 핵심 모델로
# 사용 불가하므로 키를 두지 않는다. OSS의 AI scorer는 오픈웨이트 로컬 모델을 쓴다.
